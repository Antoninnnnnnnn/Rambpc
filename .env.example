# Local application metadata; never put real values in a commit.
# These are static application identifiers, NOT a user session token.
# Fill all three using a client configuration whose use is authorized.
RAMBLER_API_KEY=
RAMBLER_ANDROID_PACKAGE=
RAMBLER_ANDROID_CERT=
# Optional service address (host:port); the SDK default is used when empty.
RAMBLER_AUTHORITY=
