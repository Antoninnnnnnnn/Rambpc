  "coverage": {
    "normal_and_context": {
      "file": "crates/rambler-cli/tests/pcm_channel_engine.rs",
      "tests": [
        "fragmented_finished_pcm_reaches_peer_as_continuous_ogg_then_normal_engine_eof",
        "late_context_waits_for_real_audio_cleanup_and_s3_end_waits_for_grpc_status"
      ],
      "assertions": [
        "Actual peer-received Ogg: CRC/framing and independently decoded duration with pre-skip/final-granule trimming; 1607 input samples at 20/1000 ms paging.",
        "Peer Opus sample packets equal those produced by the existing memory source for the same PCM/configuration; this is not PCM bit equality for a lossy codec.",
        "Exact init/audio/context/END requests, actual HTTP upload half-close, normal engine EOF and encoded progress/metrics.",
        "Late context invoked once after real audio EOF/cleanup; peer consumes Ogg EOS. S3 END cannot complete while gRPC status is withheld; terminal PermissionDenied remains an error. Peer duration checked for 967 samples."
      ]
    },
    "failure_boundaries": {
      "file": "crates/rambler-cli/tests/pcm_engine_failure.rs",
      "tests": [
        "abandoned_producer_preserves_typed_audio_error_and_finishes_cleanup",
        "engine_cancellation_wakes_full_queue_reservation_without_taking_caller_pcm",
        "early_healthy_server_end_closes_unfinished_live_producer_as_incomplete"
      ],
      "assertions": [
        "Dropping unfinished producer retains original AudioError::InputAbandoned through EngineError::Audio, cleans up without healthy audio EOF, and suppresses context.",
        "A registered reservation is genuinely Pending on a full queue before Engine::close; closure wakes it with Closed while caller bytes and pointer remain unchanged. No RPC is emitted in this gated-metadata case.",
        "Early synthetic S3 END plus gRPC OK with the producer still alive is IncompleteSession, not healthy completion; diagnostic flags, cleanup and producer closure are checked."
      ],
      "abandonment_peer_limit": "Only arrival of an audio-wrapper payload beginning with OggS is proved. An OpusHead/header page satisfies this gate; it does not establish sample-packet delivery, CRC, codec validity or decoded duration in the abandonment case."
    }
  },
